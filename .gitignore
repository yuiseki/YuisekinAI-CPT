__pycache__/
.venv
*.pyc
.env
.venv/

# Tokenised corpora and checkpoints. Both are reproducible from the code and
# the published datasets, and both are large.
*.bin
*.npy
runs/
checkpoints/
*.safetensors

# Local copies of model directories, published or not. The weights that are
# published live on the Hub; the ones that are not are kept here because a
# measurement still needs them, and neither belongs in git. The card, the
# scores and the run log are kept in tmp/scores/ as text.
#
# Written as a rule about every model directory rather than about the models
# there are today: the first version of this named qwen3 only, and the weights
# from the next run were one `git add -A` from the index.
tmp/*-jp-gov-*/
